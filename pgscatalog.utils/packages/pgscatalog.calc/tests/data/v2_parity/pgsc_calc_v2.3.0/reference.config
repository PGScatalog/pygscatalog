params.custom_config_base = null
params.max_memory = '2.GB'
params.max_cpus = 1
executor.queueSize = 4
process {
    withName: PLINK2_VCF {
        ext.args = { "--new-id-max-allele-len 100 missing --psam /Users/bwingfield/Documents/projects/pgscatalog/pygscatalog/pgscatalog.utils/packages/pgscatalog.calc/tests/data/v2_parity/" + (meta.chrom == 'Y' ? 'samples.Y.psam' : 'samples.psam') + (meta.chrom == 'X' ? ' --split-par b38' : '') }
    }
    withName: PLINK2_SCORE {
        ext.args = '--allow-extra-chr --xchr-model 1'
        ext.args2 = ''
    }
}
